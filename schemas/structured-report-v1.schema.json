{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "groot-cal/structured-report-v1",
  "title": "Structured Report v1",
  "type": "object",
  "required": [
    "status",
    "output_type",
    "report_version",
    "genre",
    "report_spec",
    "selected_result",
    "header_meta",
    "slots",
    "claims",
    "sections",
    "capability"
  ],
  "properties": {
    "status": {"const": "result"},
    "output_type": {"const": "StructuredReport"},
    "report_version": {"const": "1"},
    "genre": {"const": "executive_memo"},
    "report_spec": {"type": "object"},
    "selected_result": {
      "type": "object",
      "required": ["result_key", "selection_reason", "operator_ref", "provenance_ref"]
    },
    "header_meta": {"type": "object"},
    "slots": {"type": "object"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "slot", "statement_type", "text", "label"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^claim-[0-9]{3}$"},
          "slot": {"type": "string"},
          "statement_type": {"enum": ["fact", "arithmetic", "suggestion", "judgment", "meta"]},
          "text": {"type": "string", "minLength": 1},
          "label": {"enum": ["데이터 확인", "데이터 시사", "컨설턴트 판단", "참고치"]},
          "value": {"type": ["number", "integer"]},
          "source_ref": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "sections": {"type": "array"},
    "capability": {
      "type": "object",
      "required": ["inputs", "raw_access"],
      "properties": {
        "inputs": {"const": ["result_envelope"]},
        "raw_access": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
