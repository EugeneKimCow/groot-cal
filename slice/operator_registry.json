      "output_type": "Attribution"
    },
    "vrm_lite": {
      "version": 1,
      "operation_families": ["explain_change"],
      "inherent_scope": {"channel": "온라인"},
      "output_type": "Attribution"
    },
    "event_overlap_scan": {
      "version": 1,
      "operation_families": ["explain_change"],
      "output_type": "Description"
    }
  }
