{
  "registry_version": "1",
  "operators": {
    "metric_level": {
      "version": 1,
      "operation_families": ["inspect_level"],
      "metric_types": ["amount", "count", "balance"],
      "output_type": "MetricLevel"
    },
    "rate_level": {
      "version": 1,
      "operation_families": ["inspect_level"],
      "metric_types": ["rate"],
      "requires": ["numerator", "denominator", "denominator_weighted_mean"],
      "output_type": "MetricLevel"
    },
    "distinct_level": {
      "version": 1,
      "operation_families": ["inspect_level"],
      "metric_types": ["distinct"],
      "requires": ["entity_id_field"],
      "output_type": "MetricLevel"
    },
    "contrib_decomp": {
      "version": 1,
      "operation_families": ["explain_change"],
      "metric_types": ["amount", "count", "balance"],
      "requires": ["additive_across_dims", "mece_dimension"],
      "output_type": "Attribution"
    },
    "distinct_decomp": {
      "version": 1,
      "operation_families": ["explain_change"],
      "metric_types": ["distinct"],
      "requires": ["entity_id_field", "entity_functional_dimension"],
